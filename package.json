{
  "name": "lumilens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:backend && bun run build:frontend",
    "embed": "bun scripts/embed-avatar.mjs",
    "build:backend": "bun run embed && bun build src/backend.ts --outfile dist/backend.js --target bun",
    "build:frontend": "bun build src/frontend.ts --outfile dist/frontend.js --target browser",
    "test": "bun test",
    "test:coverage": "bun test src/backend --coverage"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "happy-dom": "^20.14.6",
    "lumiverse-spindle-types": "latest",
    "typescript": "^5.6.3"
  }
}
